# Trunk owns frontend rebuilds and reloads; UI changes do not restart Tauri.
/app/
/frontend/
/server/
/public/
/runtime/
/end2end/

# Build output and generated permissions must never restart the native watcher.
/target/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/permissions/autogenerated/

/index.html
/Trunk.toml
