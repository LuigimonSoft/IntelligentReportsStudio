{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editors",
  "description": "Editor windows may only read their own draft and return a result.",
  "windows": [
    "editor-*"
  ],
  "permissions": [
    "core:default",
    "allow-editor-context",
    "allow-finish-editor"
  ],
  "remote": {
    "urls": [
      "http://localhost:1420",
      "http://127.0.0.1:1420"
    ]
  }
}
